<script>
(function(){
  'use strict';

  var I18N = [[JSON_I18N_CHECKJS]];

  function t(str, vars){
    return str.replace(/\{(\w+)\}/g, function(_, k){ return (vars && (k in vars)) ? vars[k] : ''; });
  }

  // ---------------------------------------------------------------
  // Reference rent per m² (EUR/month) by Madrid district.
  // Rough, order-of-magnitude ranges for a typical small flat —
  // not an official source. Update these numbers as the market
  // moves; that's all this tool uses to judge "is this price
  // realistic for the area".
  // ---------------------------------------------------------------
  var DISTRICT_PRICE_PER_M2 = {
    'centro':               { low: 18, high: 30 },
    'salamanca':            { low: 20, high: 32 },
    'chamberi':             { low: 18, high: 28 },
    'chamartin':            { low: 16, high: 26 },
    'retiro':               { low: 15, high: 24 },
    'arganzuela':           { low: 14, high: 22 },
    'moncloa-aravaca':      { low: 13, high: 23 },
    'tetuan':               { low: 12, high: 19 },
    'ciudad-lineal':        { low: 11, high: 17 },
    'hortaleza':            { low: 11, high: 18 },
    'fuencarral-el-pardo':  { low: 11, high: 18 },
    'san-blas-canillejas':  { low: 9,  high: 14 },
    'barajas':              { low: 10, high: 16 },
    'latina':               { low: 9,  high: 14 },
    'carabanchel':          { low: 8,  high: 13 },
    'usera':                { low: 8,  high: 13 },
    'puente-de-vallecas':   { low: 8,  high: 12 },
    'villa-de-vallecas':    { low: 7,  high: 12 },
    'vicalvaro':            { low: 7,  high: 11 },
    'villaverde':           { low: 7,  high: 11 }
  };

  // ---------------------------------------------------------------
  // Scoring. Each triggered flag adds points; thresholds decide the
  // green / amber / red result. Tune weights or thresholds here.
  // ---------------------------------------------------------------
  var WEIGHTS = {
    priceSevere: 4,   // price/m² under 60% of the district's low end
    priceModerate: 2, // price/m² under 85% of the district's low end
    abroad: 2,
    transfer: 3,
    wu: 4,
    novideo: 2,
    rush: 2,
    lang: 1,
    platform: 1       // no public listing, or an unmoderated group/marketplace
  };
  var THRESHOLD_AMBER = 3; // score >= this => amber
  var THRESHOLD_RED = 8;   // score >= this => red

  var form = document.getElementById('checkForm');
  var resultSection = document.getElementById('result');
  var resultCard = document.getElementById('resultCard');
  var riskBadge = document.getElementById('riskBadge');
  var resultHeadline = document.getElementById('resultHeadline');
  var resultSub = document.getElementById('resultSub');
  var flagList = document.getElementById('flagList');

  var ICONS = {
    high: '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L14.7 3.86a2 2 0 0 0-3.4 0z"/></svg>',
    med:  '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>',
    low:  '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
    ok:   '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
  };

  var DISTRICT_LABELS = {};
  Array.prototype.forEach.call(document.querySelectorAll('#district option'), function(opt){
    if (opt.value) DISTRICT_LABELS[opt.value] = opt.textContent;
  });

  function computeResult(data){
    var score = 0;
    var flags = []; // { severity: 'high'|'med'|'low'|'ok', title, detail }

    var price = parseFloat(data.price);
    var size = parseFloat(data.size);
    var district = data.district;

    if (price > 0 && size > 0) {
      var perM2 = price / size;
      if (district && DISTRICT_PRICE_PER_M2[district]) {
        var ref = DISTRICT_PRICE_PER_M2[district];
        var label = DISTRICT_LABELS[district] || district;
        var vars = { district: label, perM2: perM2.toFixed(1), low: ref.low, high: ref.high };
        if (perM2 < ref.low * 0.6) {
          score += WEIGHTS.priceSevere;
          flags.push({ severity: 'high', title: t(I18N.price_severe_title, vars), detail: t(I18N.price_severe_detail, vars) });
        } else if (perM2 < ref.low * 0.85) {
          score += WEIGHTS.priceModerate;
          flags.push({ severity: 'med', title: t(I18N.price_moderate_title, vars), detail: t(I18N.price_moderate_detail, vars) });
        } else {
          flags.push({ severity: 'ok', title: t(I18N.price_ok_title, vars), detail: t(I18N.price_ok_detail, vars) });
        }
      }
    }

    if (data.f_abroad) {
      score += WEIGHTS.abroad;
      flags.push({ severity: 'med', title: I18N.abroad_title, detail: I18N.abroad_detail });
    }
    if (data.f_transfer) {
      score += WEIGHTS.transfer;
      flags.push({ severity: 'high', title: I18N.transfer_title, detail: I18N.transfer_detail });
    }
    if (data.f_wu) {
      score += WEIGHTS.wu;
      flags.push({ severity: 'high', title: I18N.wu_title, detail: I18N.wu_detail });
    }
    if (data.f_novideo) {
      score += WEIGHTS.novideo;
      flags.push({ severity: 'med', title: I18N.novideo_title, detail: I18N.novideo_detail });
    }
    if (data.f_rush) {
      score += WEIGHTS.rush;
      flags.push({ severity: 'med', title: I18N.rush_title, detail: I18N.rush_detail });
    }
    if (data.f_lang) {
      score += WEIGHTS.lang;
      flags.push({ severity: 'low', title: I18N.lang_title, detail: I18N.lang_detail });
    }
    if (data.platform === 'facebook' || data.platform === 'direct') {
      score += WEIGHTS.platform;
      var platformDetail = (data.platform === 'direct' ? I18N.platform_detail_direct : I18N.platform_detail_facebook) + ' ' + I18N.platform_detail_suffix;
      flags.push({ severity: 'low', title: I18N.platform_title, detail: platformDetail });
    }

    var level = score >= THRESHOLD_RED ? 'red' : (score >= THRESHOLD_AMBER ? 'amber' : 'green');

    // Show the worst flags first.
    var order = { high: 0, med: 1, low: 2, ok: 3 };
    flags.sort(function(a, b){ return order[a.severity] - order[b.severity]; });

    return { score: score, level: level, flags: flags };
  }

  var COPY = {
    green: { badge: I18N.badge_green, head: I18N.head_green, sub: I18N.sub_green },
    amber: { badge: I18N.badge_amber, head: I18N.head_amber, sub: I18N.sub_amber },
    red:   { badge: I18N.badge_red, head: I18N.head_red, sub: I18N.sub_red }
  };

  function severityClass(sev){
    return sev === 'high' ? 'sev-high' : sev === 'med' ? 'sev-med' : sev === 'ok' ? 'sev-ok' : 'sev-low';
  }
  function severityIcon(sev){
    return sev === 'high' ? ICONS.high : sev === 'med' ? ICONS.med : sev === 'ok' ? ICONS.ok : ICONS.low;
  }

  function renderResult(result){
    var copy = COPY[result.level];

    resultCard.className = 'result-card risk-' + result.level;
    riskBadge.innerHTML = severityIcon(result.level === 'red' ? 'high' : result.level === 'amber' ? 'med' : 'ok') + copy.badge;
    resultHeadline.textContent = copy.head;
    resultSub.textContent = copy.sub;

    flagList.innerHTML = '';
    result.flags.forEach(function(f){
      var li = document.createElement('li');
      li.className = 'flag-item ' + severityClass(f.severity);
      li.innerHTML = severityIcon(f.severity) + '<span><strong>' + f.title + '.</strong> ' + f.detail + '</span>';
      flagList.appendChild(li);
    });
    if (result.flags.length === 0) {
      var li = document.createElement('li');
      li.className = 'flag-item sev-ok';
      li.innerHTML = severityIcon('ok') + '<span>' + I18N.no_flags + '</span>';
      flagList.appendChild(li);
    }

    resultSection.classList.add('show');
  }

  function getFormData(){
    return {
      price: form.price.value,
      size: form.size.value,
      district: form.district.value,
      platform: form.platform.value,
      f_abroad: form.f_abroad.checked,
      f_transfer: form.f_transfer.checked,
      f_wu: form.f_wu.checked,
      f_novideo: form.f_novideo.checked,
      f_rush: form.f_rush.checked,
      f_lang: form.f_lang.checked
    };
  }

  function buildShareUrl(data){
    var params = new URLSearchParams();
    if (data.price) params.set('price', data.price);
    if (data.size) params.set('size', data.size);
    if (data.district) params.set('district', data.district);
    if (data.platform) params.set('platform', data.platform);
    ['f_abroad','f_transfer','f_wu','f_novideo','f_rush','f_lang'].forEach(function(k){
      if (data[k]) params.set(k, '1');
    });
    return window.location.origin + window.location.pathname + '?' + params.toString();
  }

  var lastResult = null, lastData = null;

  function runCheck(pushState){
    var data = getFormData();
    lastData = data;
    lastResult = computeResult(data);
    renderResult(lastResult);
    if (pushState !== false) {
      try { window.history.replaceState(null, '', buildShareUrl(data).replace(window.location.origin + window.location.pathname, '') || window.location.pathname); } catch (e) {}
    }
    resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    runCheck(true);
  });

  function copyToClipboard(text, cb){
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(cb, function(){ fallbackCopy(text, cb); });
    } else {
      fallbackCopy(text, cb);
    }
  }
  function fallbackCopy(text, cb){
    var ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.focus(); ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    if (cb) cb();
  }

  var copyFeedback = document.getElementById('copyFeedback');
  var feedbackTimer;
  function showFeedback(msg){
    copyFeedback.textContent = msg;
    copyFeedback.classList.add('show');
    clearTimeout(feedbackTimer);
    feedbackTimer = setTimeout(function(){ copyFeedback.classList.remove('show'); }, 2200);
  }

  document.getElementById('copyTextBtn').addEventListener('click', function(){
    if (!lastResult) return;
    var copy = COPY[lastResult.level];
    var lines = [];
    lines.push(I18N.copy_text_title + ' ' + copy.badge.toUpperCase());
    lines.push(copy.head + '.');
    lines.push('');
    lastResult.flags.forEach(function(f){ lines.push('- ' + f.title + ': ' + f.detail); });
    lines.push('');
    lines.push(I18N.copy_text_checked_at + ' ' + buildShareUrl(lastData));
    copyToClipboard(lines.join('\n'), function(){ showFeedback(I18N.copied_to_clipboard); });
  });

  document.getElementById('copyLinkBtn').addEventListener('click', function(){
    var data = lastData || getFormData();
    copyToClipboard(buildShareUrl(data), function(){ showFeedback(I18N.link_copied); });
  });

  // Prefill from a shared URL and auto-run.
  (function initFromQuery(){
    var params = new URLSearchParams(window.location.search);
    if (![...params.keys()].length) return;
    if (params.has('price')) form.price.value = params.get('price');
    if (params.has('size')) form.size.value = params.get('size');
    if (params.has('district')) form.district.value = params.get('district');
    if (params.has('platform')) form.platform.value = params.get('platform');
    ['f_abroad','f_transfer','f_wu','f_novideo','f_rush','f_lang'].forEach(function(k){
      if (params.get(k) === '1') form[k].checked = true;
    });
    runCheck(false);
  })();

})();
</script>

</body>
