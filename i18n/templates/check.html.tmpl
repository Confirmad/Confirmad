<!DOCTYPE html>
<html lang="[[HTML_LANG]]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[[meta.check_title]]</title>
<meta name="description" content="[[meta.check_description]]">
<link rel="canonical" href="[[CANONICAL_URL]]">
[[HREFLANG_LINKS]]
<meta property="og:type" content="website">
<meta property="og:site_name" content="ConfirMad">
<meta property="og:title" content="[[meta.check_title]]">
<meta property="og:description" content="[[meta.check_og_description]]">
<meta property="og:url" content="[[OG_URL]]">
<meta property="og:image" content="https://confirmad.es/confirmad-logo-horizontal.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="[[meta.check_title]]">
<meta name="twitter:description" content="[[meta.check_twitter_description]]">
<meta name="twitter:image" content="https://confirmad.es/confirmad-logo-horizontal.png">
<link rel="icon" href="/confirmad-favicon-16.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "ConfirMad",
  "url": "https://confirmad.es/",
  "logo": "https://confirmad.es/confirmad-logo-horizontal.png",
  "image": "https://confirmad.es/confirmad-logo-horizontal.png",
  "description": "[[meta.jsonld_description]]",
  "email": "contacto@confirmad.es",
  "areaServed": { "@type": "City", "name": "Madrid" },
  "address": { "@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES" },
  "priceRange": "€49–€99",
  "makesOffer": [
    { "@type": "Offer", "price": "49", "priceCurrency": "EUR", "itemOffered": { "@type": "Service", "name": "Basic check", "description": "[[meta.jsonld_offer_basic]]" } },
    { "@type": "Offer", "price": "69", "priceCurrency": "EUR", "itemOffered": { "@type": "Service", "name": "Express check", "description": "[[meta.jsonld_offer_express]]" } },
    { "@type": "Offer", "price": "99", "priceCurrency": "EUR", "itemOffered": { "@type": "Service", "name": "Live check", "description": "[[meta.jsonld_offer_live]]" } }
  ]
}
</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

:root{
  --paper: #EEF1EF;
  --card: #FFFFFF;
  --ink: #16233B;
  --ink-soft: #4B5768;
  --ink-faint: #636C79;
  --stamp: #2F5D45;
  --stamp-dark: #234634;
  --verified: #2F5D45;
  --line: #D7DCD8;
  --red: #A63A34;
  --amber: #986609;
  --font: 'Figtree', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;
  --max: 760px;
}
*{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }
body{
  margin:0; background: var(--paper); color: var(--ink);
  font-family: var(--font); line-height: 1.6; -webkit-font-smoothing: antialiased;
}
img, svg{ display:block; max-width:100%; }
a{ color: var(--stamp); }
a:hover{ color: var(--stamp-dark); }
.wrap{ max-width: var(--max); margin: 0 auto; padding: 0 22px; }
h1,h2,h3{ font-family: var(--font); font-weight:700; letter-spacing:-0.02em; margin:0; color: var(--ink); }
p{ margin:0 0 1em; color: var(--ink-soft); }
:focus-visible{ outline: 2px solid var(--stamp); outline-offset: 3px; }

header.site{
  position: sticky; top:0; z-index: 50;
  background: rgba(238,241,239,0.92); backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line);
}
nav.wrap{ max-width:1120px; display:flex; align-items:center; justify-content: space-between; padding: 16px 28px; gap:18px; }
.brand{ display:flex; align-items:center; text-decoration:none; flex:none; }
.brand-logo{ height:30px; width:auto; max-width:none; display:block; }
.nav-links{ display:none; align-items:center; gap:28px; list-style:none; margin:0; padding:0; }
.nav-links a{ text-decoration:none; color: var(--ink-soft); font-size:0.94rem; }
.nav-links a:hover{ color: var(--ink); }
.nav-links a.current{ color: var(--stamp); }
@media (min-width:760px){ .nav-links{ display:flex; } }
.nav-right{ display:flex; align-items:center; gap:14px; margin-left:auto; }
.lang-switch{
  display:flex; align-items:center; gap:7px;
  font-family: var(--font-mono); font-size:0.74rem; font-weight:600; letter-spacing:0.02em;
}
.lang-switch a{ text-decoration:none; color: var(--ink-faint); }
.lang-switch a:hover{ color: var(--ink); }
.lang-switch a.lang-current{ color: var(--stamp); }
@media (max-width: 520px){ .lang-switch{ display:none; } }
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  font-family: var(--font); font-weight:700; font-size:0.94rem;
  padding: 12px 22px; border-radius:999px;
  text-decoration:none; cursor:pointer; border:1.5px solid transparent;
  transition: background-color .15s ease, transform .15s ease, box-shadow .15s ease;
  white-space:nowrap;
}
.btn:hover{ transform: translateY(-2px); }
.btn-primary{ background: var(--stamp); color:#fff; }
.btn-primary:hover{ background: var(--stamp-dark); color:#fff; }
.btn-outline{ background: transparent; border-color: var(--line); color: var(--ink); }
.btn-outline:hover{ border-color: var(--ink-faint); background: rgba(22,35,59,0.03); }
.btn-block{ width:100%; }
.nav-cta{ padding: 9px 14px; font-size:0.86rem; }
@media (min-width:760px){ .nav-cta{ padding:11px 20px; font-size:0.94rem; } }
@media (max-width: 400px){
  .brand-logo{ height: 24px; }
  .nav-cta{ padding: 7px 10px; font-size: 0.76rem; }
  nav.wrap{ gap: 10px; }
}

main{ padding: 40px 0 80px; }

.tool-head{ max-width: 62ch; margin-bottom: 32px; }
.tool-head .eyebrow{
  display:inline-block; font-family: var(--font-mono); font-size:0.78rem; font-weight:600;
  color: var(--stamp); letter-spacing:0.04em; text-transform:uppercase; margin-bottom:10px;
}
.tool-head h1{ font-size: clamp(1.6rem, 3.4vw, 2.1rem); margin-bottom:12px; line-height:1.25; }
.tool-head p{ font-size:0.98rem; }
.privacy-note{
  display:flex; gap:8px; align-items:flex-start; font-size:0.82rem; color: var(--ink-faint);
  background: rgba(47,93,69,0.06); border:1px solid rgba(47,93,69,0.18); border-radius:10px;
  padding:10px 12px; margin-top:16px;
}
.privacy-note svg{ flex:none; width:16px; height:16px; margin-top:2px; color: var(--stamp); }

/* ---------- form ---------- */
.tool-card{
  background: var(--card); border:1px solid var(--line); border-radius:18px;
  padding: 26px 24px; box-shadow: 0 20px 40px -28px rgba(22,35,59,0.25);
  margin-bottom: 28px;
}
fieldset{ border:0; margin:0; padding:0; min-width:0; }
legend{
  font-family: var(--font-mono); font-size:0.78rem; font-weight:600; color: var(--ink-faint);
  text-transform: uppercase; letter-spacing:0.04em; padding:0 0 14px; width:100%;
  border-bottom:1px solid var(--line); margin-bottom:18px;
}
.grid-2{ display:grid; grid-template-columns:1fr; gap:16px; }
@media (min-width:560px){ .grid-2{ grid-template-columns:1fr 1fr; } }
.field{ display:flex; flex-direction:column; gap:6px; margin-bottom:16px; }
.field label{ font-size:0.85rem; font-weight:600; color: var(--ink); }
.field input, .field select{
  width:100%; min-width:0;
  background:#fff; border:1px solid var(--line); color: var(--ink);
  padding:12px 13px; border-radius:10px; font-family: var(--font); font-size:0.95rem;
  transition: border-color .15s ease, box-shadow .15s ease;
}
.field input:focus, .field select:focus{
  outline:none; border-color: var(--stamp); box-shadow: 0 0 0 3px rgba(47,93,69,0.18);
}
.field-prefix{ position:relative; }
.field-prefix span{
  position:absolute; left:13px; top:50%; transform:translateY(-50%);
  color: var(--ink-faint); font-size:0.95rem; pointer-events:none;
}
.field-prefix input{ padding-left:28px; }

.check-list{ list-style:none; margin:0 0 6px; padding:0; display:flex; flex-direction:column; gap:10px; }
.check-row{
  display:flex; align-items:flex-start; gap:12px; cursor:pointer;
  background:#fff; border:1px solid var(--line); border-radius:12px; padding:13px 14px;
  transition: border-color .15s ease, background-color .15s ease;
}
.check-row:hover{ border-color: var(--ink-faint); }
.check-row input{
  flex:none; width:18px; height:18px; margin-top:2px; accent-color: var(--stamp); cursor:pointer;
}
.check-row span{ font-size:0.92rem; color: var(--ink); line-height:1.45; }
.check-row input:checked ~ span{ color: var(--ink); }
.check-row:has(input:checked){ border-color: var(--stamp); background: rgba(47,93,69,0.05); }

/* ---------- result ---------- */
#result{ display:none; }
#result.show{ display:block; }
.result-card{
  background: var(--card); border:1px solid var(--line); border-radius:18px;
  padding: 26px 24px; box-shadow: 0 20px 40px -28px rgba(22,35,59,0.25);
  margin-bottom: 20px; border-top-width:5px; border-top-style:solid;
}
.result-card.risk-green{ border-top-color: var(--stamp); }
.result-card.risk-amber{ border-top-color: var(--amber); }
.result-card.risk-red{ border-top-color: var(--red); }

.risk-badge{
  display:inline-flex; align-items:center; gap:8px; font-family: var(--font-mono);
  font-weight:600; font-size:0.82rem; letter-spacing:0.03em; text-transform:uppercase;
  padding:7px 14px; border-radius:999px; margin-bottom:14px;
}
.risk-badge svg{ width:15px; height:15px; }
.risk-green .risk-badge{ background: rgba(47,93,69,0.1); color: var(--stamp); }
.risk-amber .risk-badge{ background: rgba(152,102,9,0.1); color: var(--amber); }
.risk-red .risk-badge{ background: rgba(166,58,52,0.1); color: var(--red); }

.result-headline{ font-size:1.25rem; margin-bottom:6px; }
.result-sub{ font-size:0.92rem; margin-bottom:18px; }

.flag-list{ list-style:none; margin:0 0 18px; padding:0; display:flex; flex-direction:column; gap:10px; }
.flag-item{
  display:flex; gap:11px; align-items:flex-start; font-size:0.9rem; color: var(--ink-soft);
  padding:12px 13px; border-radius:10px; border:1px solid var(--line);
}
.flag-item.sev-high{ border-color: rgba(166,58,52,0.35); background: rgba(166,58,52,0.05); }
.flag-item.sev-med{ border-color: rgba(152,102,9,0.35); background: rgba(152,102,9,0.05); }
.flag-item.sev-low{ border-color: var(--line); background: rgba(22,35,59,0.02); }
.flag-item.sev-ok{ border-color: rgba(47,93,69,0.3); background: rgba(47,93,69,0.05); }
.flag-item svg{ flex:none; width:17px; height:17px; margin-top:1px; }
.flag-item.sev-high svg{ color: var(--red); }
.flag-item.sev-med svg{ color: var(--amber); }
.flag-item.sev-low svg{ color: var(--ink-faint); }
.flag-item.sev-ok svg{ color: var(--stamp); }
.flag-item strong{ color: var(--ink); }

.disclaimer{
  font-size:0.82rem; color: var(--ink-faint); border-top:1px solid var(--line);
  padding-top:14px; margin-bottom:18px;
}
.result-ctas{ display:flex; flex-wrap:wrap; gap:10px; }
.result-ctas .btn{ flex:1 1 auto; }

.share-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:36px; }
.share-row .btn{ font-size:0.85rem; padding:9px 16px; }
.copy-feedback{
  font-size:0.8rem; color: var(--stamp); font-weight:600; align-self:center;
  opacity:0; transition: opacity .2s ease;
}
.copy-feedback.show{ opacity:1; }

footer{ padding: 34px 0 50px; border-top: 1px solid #2B3A54; background: var(--ink); color: #8B96A8; }
footer .wrap{ max-width:1120px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px; font-size:0.85rem; }
footer a{ color:#C7CFD8; text-decoration:none; }
footer a:hover{ text-decoration:underline; }
footer .lang-switch{ display:flex; }
footer .lang-switch a{ color:#8B96A8; }
footer .lang-switch a:hover{ color:#fff; }
footer .lang-switch a.lang-current{ color:#fff; }

.whatsapp-float{
  position:fixed; right:20px; bottom:20px; z-index:60;
  width:56px; height:56px; border-radius:50%;
  background: var(--stamp); color:#fff;
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 12px 24px -8px rgba(22,35,59,0.45);
  transition: transform .15s ease, box-shadow .15s ease;
  animation: waFloatIn .4s cubic-bezier(.2,1.4,.4,1) .6s both;
}
.whatsapp-float:hover{ transform: translateY(-3px) scale(1.05); box-shadow: 0 16px 28px -8px rgba(22,35,59,0.55); }
.whatsapp-float:active{ transform: scale(0.95); }
.whatsapp-float svg{ width:28px; height:28px; }
@keyframes waFloatIn{ 0%{ opacity:0; transform: scale(0.5); } 100%{ opacity:1; transform: scale(1); } }
@media (prefers-reduced-motion: reduce){ .whatsapp-float{ animation:none; } }
@media (max-width:480px){ .whatsapp-float{ right:14px; bottom:14px; width:50px; height:50px; } .whatsapp-float svg{ width:24px; height:24px; } }
</style>
</head>
<body>

<header class="site">
  <nav class="wrap">
    <a href="index.html#top" class="brand"><img src="/confirmad-logo-horizontal.png" alt="ConfirMad" class="brand-logo"></a>
    <ul class="nav-links">
      <li><a href="index.html#how">[[nav.how]]</a></li>
      <li><a href="index.html#pricing">[[nav.pricing]]</a></li>
      <li><a href="check.html" class="current">[[nav.free_check]]</a></li>
      <li><a href="index.html#faq">[[nav.faq]]</a></li>
    </ul>
    <div class="nav-right">
      [[LANG_SELECTOR]]
      <a href="index.html#pricing" class="btn btn-primary nav-cta">[[nav.request_cta]]</a>
    </div>
  </nav>
</header>

<main>
  <div class="wrap">

    <div class="tool-head">
      <span class="eyebrow">[[check_tool.eyebrow]]</span>
      <h1>[[check_tool.h1]]</h1>
      <p>[[check_tool.lede]]</p>
      <div class="privacy-note">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        <span>[[check_tool.privacy_note]]</span>
      </div>
    </div>

    <form id="checkForm" class="tool-card" novalidate>
      <fieldset>
        <legend>[[check_tool.legend_listing]]</legend>
        <div class="grid-2">
          <div class="field field-prefix">
            <label for="price">[[check_tool.price_label]]</label>
            <span>€</span>
            <input type="number" id="price" name="price" min="0" step="1" inputmode="numeric" placeholder="[[check_tool.price_placeholder]]">
          </div>
          <div class="field field-prefix">
            <label for="size">[[check_tool.size_label]]</label>
            <input type="number" id="size" name="size" min="0" step="1" inputmode="numeric" placeholder="[[check_tool.size_placeholder]]">
            <span style="left:auto; right:13px;">m²</span>
          </div>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="district">[[check_tool.district_label]]</label>
            <select id="district" name="district">
              <option value="">[[check_tool.district_not_sure]]</option>
              <option value="centro">[[check_js.district_labels.centro]]</option>
              <option value="arganzuela">[[check_js.district_labels.arganzuela]]</option>
              <option value="retiro">[[check_js.district_labels.retiro]]</option>
              <option value="salamanca">[[check_js.district_labels.salamanca]]</option>
              <option value="chamartin">[[check_js.district_labels.chamartin]]</option>
              <option value="tetuan">[[check_js.district_labels.tetuan]]</option>
              <option value="chamberi">[[check_js.district_labels.chamberi]]</option>
              <option value="fuencarral-el-pardo">[[check_js.district_labels.fuencarral-el-pardo]]</option>
              <option value="moncloa-aravaca">[[check_js.district_labels.moncloa-aravaca]]</option>
              <option value="latina">[[check_js.district_labels.latina]]</option>
              <option value="carabanchel">[[check_js.district_labels.carabanchel]]</option>
              <option value="usera">[[check_js.district_labels.usera]]</option>
              <option value="puente-de-vallecas">[[check_js.district_labels.puente-de-vallecas]]</option>
              <option value="villa-de-vallecas">[[check_js.district_labels.villa-de-vallecas]]</option>
              <option value="vicalvaro">[[check_js.district_labels.vicalvaro]]</option>
              <option value="ciudad-lineal">[[check_js.district_labels.ciudad-lineal]]</option>
              <option value="hortaleza">[[check_js.district_labels.hortaleza]]</option>
              <option value="villaverde">[[check_js.district_labels.villaverde]]</option>
              <option value="san-blas-canillejas">[[check_js.district_labels.san-blas-canillejas]]</option>
              <option value="barajas">[[check_js.district_labels.barajas]]</option>
            </select>
          </div>
          <div class="field">
            <label for="platform">[[check_tool.platform_label]]</label>
            <select id="platform" name="platform">
              <option value="idealista">[[check_tool.platform_idealista]]</option>
              <option value="fotocasa">[[check_tool.platform_fotocasa]]</option>
              <option value="airbnb">[[check_tool.platform_airbnb]]</option>
              <option value="badi">[[check_tool.platform_badi]]</option>
              <option value="facebook">[[check_tool.platform_facebook]]</option>
              <option value="direct">[[check_tool.platform_direct]]</option>
              <option value="other">[[check_tool.platform_other]]</option>
            </select>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>[[check_tool.legend_landlord]]</legend>
        <ul class="check-list">
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_abroad" name="f_abroad"><span>[[check_tool.f_abroad]]</span></label></li>
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_transfer" name="f_transfer"><span>[[check_tool.f_transfer]]</span></label></li>
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_wu" name="f_wu"><span>[[check_tool.f_wu]]</span></label></li>
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_novideo" name="f_novideo"><span>[[check_tool.f_novideo]]</span></label></li>
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_rush" name="f_rush"><span>[[check_tool.f_rush]]</span></label></li>
          <li class="check-row"><label style="display:flex; gap:12px; width:100%; cursor:pointer;"><input type="checkbox" id="f_lang" name="f_lang"><span>[[check_tool.f_lang]]</span></label></li>
        </ul>
      </fieldset>

      <button type="submit" class="btn btn-primary btn-block">[[check_tool.submit]]</button>
    </form>

    <section id="result">
      <div class="result-card" id="resultCard">
        <span class="risk-badge" id="riskBadge"></span>
        <h2 class="result-headline" id="resultHeadline"></h2>
        <p class="result-sub" id="resultSub"></p>

        <ul class="flag-list" id="flagList"></ul>

        <p class="disclaimer">[[check_tool.disclaimer]]</p>

        <div class="result-ctas">
          <a href="index.html#pricing" class="btn btn-primary">[[check_tool.cta_primary]]</a>
          <a href="index.html#faq" class="btn btn-outline">[[check_tool.cta_secondary]]</a>
        </div>
      </div>

      <div class="share-row">
        <button type="button" class="btn btn-outline" id="copyTextBtn">[[check_tool.copy_text_btn]]</button>
        <button type="button" class="btn btn-outline" id="copyLinkBtn">[[check_tool.copy_link_btn]]</button>
        <span class="copy-feedback" id="copyFeedback">Copied</span>
      </div>
    </section>

  </div>
</main>

<footer>
  <div class="wrap">
    <div>ConfirMad · Madrid, Spain</div>
    <div><a href="mailto:contacto@confirmad.es">contacto@confirmad.es</a> · <a href="https://wa.me/34639589180">WhatsApp: +34 639 589 180</a></div>
    <div><a href="/aviso-legal.html">[[footer.legal_notice]]</a> · <a href="/privacidad.html">[[footer.privacy]]</a> · <a href="/cookies.html">[[footer.cookies]]</a> · <a href="/terminos.html">[[footer.terms]]</a></div>
    [[LANG_SELECTOR]]
  </div>
</footer>

<a class="whatsapp-float" href="https://wa.me/34639589180?text=[[WA_FLOAT_TEXT]]" target="_blank" rel="noopener" aria-label="[[whatsapp.aria_label]]">
  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.004 3C9.377 3 4 8.377 4 15.004c0 2.313.638 4.474 1.746 6.323L4 29l7.868-1.706A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.63 28 15.004 28 8.377 22.63 3 16.004 3zm0 21.6c-1.98 0-3.87-.52-5.52-1.5l-.396-.235-4.67 1.013 1.024-4.55-.258-.416A9.55 9.55 0 0 1 6.4 15.004C6.4 9.69 10.69 5.4 16.004 5.4S25.6 9.69 25.6 15.004 21.318 24.6 16.004 24.6zm5.36-7.19c-.294-.147-1.737-.858-2.006-.956-.27-.098-.466-.147-.663.147-.196.294-.76.956-.932 1.152-.172.196-.343.22-.637.073-.294-.147-1.24-.457-2.362-1.457-.873-.778-1.462-1.74-1.633-2.034-.172-.294-.018-.453.129-.6.132-.132.294-.343.44-.514.147-.172.196-.294.294-.49.098-.196.049-.368-.024-.514-.073-.147-.663-1.6-.909-2.19-.24-.577-.484-.5-.663-.51-.172-.008-.368-.01-.564-.01-.196 0-.514.073-.784.368-.27.294-1.03 1.007-1.03 2.457 0 1.45 1.055 2.85 1.202 3.046.147.196 2.077 3.17 5.032 4.445.703.303 1.252.484 1.68.62.706.225 1.348.193 1.856.117.566-.084 1.737-.71 1.982-1.396.245-.686.245-1.274.172-1.396-.073-.122-.27-.196-.564-.343z"/></svg>
